<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0.100'))">$(TargetFrameworks);net9.0;net10.0</TargetFrameworks>
    <RootNamespace>VietQR.Deeplink.Client</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <NuGetAudit>false</NuGetAudit>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>VietQR.Deeplink.Client</PackageId>
    <Title>VietQR.Deeplink.Client - Thư viện client gọi API mở app ngân hàng VietQR (.NET)</Title>
    <Version>1.0.0</Version>
    <Authors>Hien Dev</Authors>
    <Company>Ngochiendev</Company>
    <Description>Thư viện client C# (.NET) kết nối dịch vụ VietQR Deeplink để lấy link mở ứng dụng ngân hàng khi thanh toán, hỗ trợ Dependency Injection trong ASP.NET Core.</Description>
    <PackageTags>vietqr;deeplink;banking;csharp;dotnet;aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Ngochiendev/vietqr-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Ngochiendev/vietqr-core</PackageProjectUrl>
    <PackageReleaseNotes>See https://github.com/Ngochiendev/vietqr-core/releases for the latest release notes.</PackageReleaseNotes>

    <!-- SourceLink, Symbols & Deterministic Builds -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\..\version.props" Condition="Exists('$(MSBuildProjectDirectory)\..\..\version.props')" />

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VietQR.Core" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

</Project>
