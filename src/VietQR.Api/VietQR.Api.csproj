<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VietQR.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>false</IsPackable>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- Luôn lấy phiên bản VietQR.Core và VietQR.Deeplink.Client mới nhất từ NuGet -->
    <PackageReference Include="VietQR.Core" Version="*" />
    <PackageReference Include="VietQR.Deeplink.Client" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="vietqr_core.Tests" />
  </ItemGroup>



  <PropertyGroup Condition="Exists('..\VietQR.Deeplink\VietQR.Deeplink.csproj')">
    <DefineConstants>$(DefineConstants);HAS_VIETQR_DEEPLINK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\VietQR.Deeplink\VietQR.Deeplink.csproj')">
    <ProjectReference Include="..\VietQR.Deeplink\VietQR.Deeplink.csproj" />
  </ItemGroup>
</Project>
