<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VietQR.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>false</IsPackable>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\VietQR.Core\VietQR.Core.csproj')">
    <ProjectReference Include="..\VietQR.Core\VietQR.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\VietQR.Core\VietQR.Core.csproj')">
    <PackageReference Include="VietQR.Core" Version="*" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\VietQR.Deeplink.Client\VietQR.Deeplink.Client.csproj')">
    <ProjectReference Include="..\VietQR.Deeplink.Client\VietQR.Deeplink.Client.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\VietQR.Deeplink.Client\VietQR.Deeplink.Client.csproj')">
    <PackageReference Include="VietQR.Deeplink.Client" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="vietqr_core.Tests" />
  </ItemGroup>



  <PropertyGroup Condition="Exists('..\VietQR.Deeplink\VietQR.Deeplink.csproj')">
    <DefineConstants>$(DefineConstants);HAS_VIETQR_DEEPLINK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\VietQR.Deeplink\VietQR.Deeplink.csproj')">
    <ProjectReference Include="..\VietQR.Deeplink\VietQR.Deeplink.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\VietQR.Deeplink\wwwroot\icons')">
    <Content Include="..\VietQR.Deeplink\wwwroot\icons\**" Link="wwwroot\icons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
