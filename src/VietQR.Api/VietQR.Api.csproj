<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VietQR.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Luôn lấy phiên bản VietQR.Core mới nhất từ NuGet (1.*) -->
    <PackageReference Include="VietQR.Core" Version="*" />
    <ProjectReference Include="..\VietQR.Deeplink.Client\VietQR.Deeplink.Client.csproj" Condition="Exists('..\VietQR.Deeplink.Client\VietQR.Deeplink.Client.csproj')" />
    <PackageReference Include="VietQR.Deeplink.Client" Version="*" Condition="!Exists('..\VietQR.Deeplink.Client\VietQR.Deeplink.Client.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="vietqr_core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\all_banks_gallery.html" />
    <None Include="wwwroot\all_banks_gallery.html" />
  </ItemGroup>


  <PropertyGroup Condition="Exists('..\VietQR.Deeplink\VietQR.Deeplink.csproj')">
    <DefineConstants>;HAS_VIETQR_DEEPLINK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\VietQR.Deeplink\VietQR.Deeplink.csproj')">
    <ProjectReference Include="..\VietQR.Deeplink\VietQR.Deeplink.csproj" />
  </ItemGroup>
</Project>
