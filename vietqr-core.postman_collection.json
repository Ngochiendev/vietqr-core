{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-vietqrcore01",
    "name": "VietQR.Core API (NAPAS247 & EMVCo)",
    "description": "Bộ sưu tập API tích hợp thanh toán VietQR chuẩn NAPAS247 & EMVCo. Hỗ trợ sinh chuỗi mã, render ảnh thẻ thanh toán (compact / qr_only / print), giải mã ảnh, phân tích cú pháp chuỗi và cổng Deeplink mở ứng dụng ngân hàng di động tự điền.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5187",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Tạo mã VietQR (Generate)",
      "item": [
        {
          "name": "1.1 Tạo thẻ VietQR đầy đủ (POST - Khuyên dùng)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankBin\": \"970422\",\n  \"accountNo\": \"056789799999\",\n  \"accountName\": \"NGUYEN VAN A\",\n  \"amount\": \"50000\",\n  \"description\": \"thanh toan don hang\",\n  \"template\": \"compact\",\n  \"format\": \"png\",\n  \"serviceType\": \"account\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "generate"]
            },
            "description": "Khởi tạo mã VietQR chuẩn EMVCo và ảnh thẻ thanh toán (Base64 Data URL) qua JSON Body. Hỗ trợ truyền logo tùy chỉnh ở tâm QR qua trường customLogoBase64."
          },
          "response": []
        },
        {
          "name": "1.2 Tạo mã VietQR nhanh (GET Query)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/generate?bankBin=970422&accountNo=056789799999&amount=50000&description=thanh toan don hang&template=compact",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "generate"],
              "query": [
                {
                  "key": "bankBin",
                  "value": "970422",
                  "description": "Mã BIN 6 số của ngân hàng (VD: 970422 - MBBank, 970423 - TPBank)"
                },
                {
                  "key": "accountNo",
                  "value": "056789799999",
                  "description": "Số tài khoản hoặc số thẻ người thụ hưởng"
                },
                {
                  "key": "amount",
                  "value": "50000",
                  "description": "Số tiền thanh toán (VNĐ)"
                },
                {
                  "key": "description",
                  "value": "thanh toan don hang",
                  "description": "Nội dung chuyển tiền"
                },
                {
                  "key": "template",
                  "value": "compact",
                  "description": "Mẫu thẻ: compact (thẻ chuẩn), qr_only (chỉ mã QR), print (in hóa đơn)"
                }
              ]
            },
            "description": "Tạo mã VietQR và ảnh thẻ qua tham số URL thuận tiện cho việc tích hợp nhanh qua phương thức GET."
          },
          "response": []
        },
        {
          "name": "1.3 Tạo chỉ mã QR vuông tinh gọn (template: qr_only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/generate?bankBin=970422&accountNo=056789799999&amount=50000&description=thanh toan don hang&template=qr_only&size=500",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "generate"],
              "query": [
                {
                  "key": "bankBin",
                  "value": "970422"
                },
                {
                  "key": "accountNo",
                  "value": "056789799999"
                },
                {
                  "key": "amount",
                  "value": "50000"
                },
                {
                  "key": "description",
                  "value": "thanh toan don hang"
                },
                {
                  "key": "template",
                  "value": "qr_only",
                  "description": "Mẫu tinh gọn: chỉ chứa ma trận QR vuông 500x500px kèm logo ở tâm"
                },
                {
                  "key": "size",
                  "value": "500",
                  "description": "Kích thước ảnh vuông px (100 - 2000)"
                }
              ]
            },
            "description": "Tạo ảnh mã QR vuông tinh gọn chỉ chứa mã QR và logo ở tâm, không có khung viền và header/footer thẻ."
          },
          "response": []
        },
        {
          "name": "1.4 Tạo thẻ VietQR mẫu in đầy đủ (template: print)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/generate?bankBin=970422&accountNo=056789799999&accountName=NGUYEN VAN A&amount=50000&description=thanh toan don hang&template=print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "generate"],
              "query": [
                {
                  "key": "bankBin",
                  "value": "970422"
                },
                {
                  "key": "accountNo",
                  "value": "056789799999"
                },
                {
                  "key": "accountName",
                  "value": "NGUYEN VAN A",
                  "description": "Tên chủ tài khoản thụ hưởng hiển thị in hoa"
                },
                {
                  "key": "amount",
                  "value": "50000"
                },
                {
                  "key": "description",
                  "value": "thanh toan don hang"
                },
                {
                  "key": "template",
                  "value": "print",
                  "description": "Mẫu in hóa đơn: mã QR kèm 5 dòng thông tin thanh toán chi tiết"
                }
              ]
            },
            "description": "Tạo thẻ VietQR khổ in (print) đầy đủ thông tin: Header, mã QR, logo ngân hàng cùng chi tiết số tiền, nội dung, chủ TK và tên ngân hàng."
          },
          "response": []
        },
        {
          "name": "1.5 Xuất trực tiếp stream file ảnh (GET Image)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/image?bankBin=970422&accountNo=056789799999&amount=50000&description=thanh toan don hang&template=compact&format=png",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "image"],
              "query": [
                {
                  "key": "bankBin",
                  "value": "970422"
                },
                {
                  "key": "accountNo",
                  "value": "056789799999"
                },
                {
                  "key": "amount",
                  "value": "50000"
                },
                {
                  "key": "description",
                  "value": "thanh toan don hang"
                },
                {
                  "key": "template",
                  "value": "compact"
                },
                {
                  "key": "format",
                  "value": "png",
                  "description": "png, webp hoặc svg"
                }
              ]
            },
            "description": "Trả về trực tiếp binary stream hình ảnh (Content-Type: image/png), dùng gắn thẳng vào thẻ <img src='...'> của website mà không cần xử lý Base64."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Phân tích & Giải mã (Parse & Decode)",
      "item": [
        {
          "name": "2.1 Phân tích cú pháp chuỗi EMVCo (Parse)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrCode\": \"00020101021238560010A0000007270126000697042201120567897999990208QRIBFTTA53037045405500005802VN62230819thanh toan don hang6304B18D\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/parse",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "parse"]
            },
            "description": "Phân tích chuỗi VietQR EMVCo thành đối tượng có cấu trúc: Ngân hàng thụ hưởng, số tài khoản, số tiền, nội dung thanh toán và xác thực mã CRC16 Tag 63."
          },
          "response": []
        },
        {
          "name": "2.2 Giải mã mã QR từ ảnh Base64 (Decode)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageBase64\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAA...\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/decode",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "decode"]
            },
            "description": "Quét và giải mã hình ảnh chứa mã QR (chuỗi Base64 hoặc upload form-data trường 'file') để trích xuất dữ liệu thanh toán VietQR."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Danh mục Ngân hàng (Banks)",
      "item": [
        {
          "name": "3.1 Lấy toàn bộ danh mục 76+ ngân hàng NAPAS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/banks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "banks"]
            },
            "description": "Lấy danh sách toàn bộ 76+ ngân hàng thành viên liên minh NAPAS nhúng sẵn trong hệ thống (mã BIN, tên viết tắt, tên đầy đủ, URL logo CDN)."
          },
          "response": []
        },
        {
          "name": "3.2 Tra cứu ngân hàng theo mã BIN hoặc mã viết tắt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/banks/970422",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "banks", "970422"]
            },
            "description": "Tra cứu thông tin ngân hàng theo mã BIN gồm 6 chữ số (ví dụ: 970422) hoặc mã viết tắt (ví dụ: MB, VCB, TPB)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Cổng Deeplink mở App Ngân hàng (Deeplink)",
      "item": [
        {
          "name": "4.1 Tạo liên kết mở app tự điền thanh toán (Create Intent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appCode\": \"MB\",\n  \"qrCode\": \"00020101021238560010A0000007270126000697042201120567897999990208QRIBFTTA53037045405500005802VN62230819thanh toan don hang6304B18D\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/deeplink/intents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "deeplink", "intents"]
            },
            "description": "Khởi tạo liên kết điều hướng thanh toán 1-chạm (Bridge URL ngắn hạn). Khi khách hàng bấm vào link trên điện thoại di động, hệ thống tự động mở app ngân hàng tương ứng và điền sẵn số tài khoản, số tiền, nội dung."
          },
          "response": []
        }
      ]
    }
  ]
}
