    {
      "name": "2. Danh mục Ngân hàng (Banks)",
      "item": [
        {
          "name": "2.1 Lấy danh sách ngân hàng qua Controller API",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/banks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "banks"]
            },
            "description": "Lấy toàn bộ danh sách ngân hàng thành viên NAPAS (được cache trong file banks.json)."
          },
          "response": []
        },
        {
          "name": "2.2 Đọc trực tiếp file tĩnh từ wwwroot",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/data/banks.json",
              "host": ["{{baseUrl}}"],
              "path": ["data", "banks.json"]
            },
            "description": "Truy cập trực tiếp file tĩnh banks.json thông qua Static Files Middleware của ASP.NET Core."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Vận hành & Chẩn đoán Hạ tầng (Operations & Diagnostics)",
      "item": [
        {
          "name": "3.1 Chẩn đoán quyền Đọc - Ghi - Xóa trên IIS Server",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/test-rw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "test-rw"]
            },
            "description": "Kiểm tra thực tế 4 thao tác phân quyền trực tiếp trên ổ đĩa thư mục wwwroot/data của IIS Windows Server."
          },
          "response": []
        },
        {
          "name": "3.2 Báo cáo trạng thái tiến trình đồng bộ ngầm & IIS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/sync-status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "sync-status"]
            },
            "description": "Lấy chi tiết trạng thái tiến trình chạy ngầm: thời gian đồng bộ tiếp theo lúc 01:00 AM, dung lượng logos, quyền ghi thực tế và hướng dẫn icacls nếu bị lỗi."
          },
          "response": []
        },
        {
          "name": "3.3 Kích hoạt đồng bộ ngân hàng & tải logo ngay lập tức",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
