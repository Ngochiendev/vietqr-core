              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/sync-now",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "sync-now"]
            },
            "description": "Chủ động kích hoạt đồng bộ toàn bộ danh mục ngân hàng và tải toàn bộ logo PNG từ CDN về máy chủ."
          },
          "response": []
        },
        {
          "name": "3.4 Kiểm thử chất lượng toàn diện hệ thống (Self-Test)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/self-test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "self-test"]
            },
            "description": "Tự động kiểm tra chất lượng toàn diện trên IIS Server: thuật toán CRC16, chuẩn EMVCo, engine SkiaSharp render 3 template, phân quyền đĩa cứng và tốc độ xử lý."
          },
          "response": []
        },
        {
          "name": "3.5 Kiểm thử tải 2.000 đến 10.000 mã QR học phí (Stress & Load Test)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/benchmark-school-test?testRequests=2000&template=qr_only&totalSchools=1000&studentsPerSchool=1000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "benchmark-school-test"],
              "query": [
                {
                  "key": "testRequests",
                  "value": "2000",
                  "description": "Số lượng mã QR tạo thực tế trên server (VD: 2000 hoặc 10000, tối đa 50.000)"
                },
                {
                  "key": "template",
                  "value": "qr_only",
                  "description": "Mẫu template: 'qr_only' (siêu tốc ~760 req/s, 10.000 QR chỉ ~13s), 'print' (thẻ in) hoặc 'emv_only' (chỉ chuỗi text)"
                },
                {
                  "key": "totalSchools",
                  "value": "1000",
                  "description": "Quy mô số trường học muốn dự phóng (VD: 1000)"
                },
                {
                  "key": "studentsPerSchool",
                  "value": "1000",
                  "description": "Số học sinh trung bình mỗi trường muốn dự phóng (VD: 1000)"
                }
              ]
            },
            "description": "Chạy kịch bản tạo thực tế 2.000 hoặc 10.000 mã QR song song trên máy chủ IIS: Đo đạc tốc độ phản hồi (ms/QR), Throughput (QR/s), RAM tiêu thụ và dự phóng thời gian cho 1.000 trường."
          },
          "response": []
        }
      ]
    }
