{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-vietqrcore01",
    "name": "VietQR Core API (NAPAS247 Microservice)",
    "description": "Bộ sưu tập Postman Collection đầy đủ cho Microservice vietqr-core chuẩn NAPAS247. Hỗ trợ tạo chuỗi EMVCo, render ảnh thẻ chuẩn (compact), ảnh mã QR tinh gọn (qr_only) và thẻ in đầy đủ thông tin thanh toán (print), cùng bộ API chẩn đoán phân quyền IIS Windows Server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"   
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5187",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Tạo mã VietQR (Generate)",
      "item": [
        {
          "name": "1.1 Tạo thẻ VietQR đầy đủ (template: compact)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/generate?bankBin=970422&accountNo=056789799999&amount=50000&description=thanh toan hoc phi&template=compact",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "generate"],
              "query": [
                {
                  "key": "bankBin",
                  "value": "970422",
                  "description": "Mã BIN 6 số của ngân hàng (VD: 970422 - MBBank)"
                },
                {
                  "key": "accountNo",
                  "value": "056789799999",
                  "description": "Số tài khoản hoặc số thẻ người thụ hưởng"
                },
                {
                  "key": "amount",
                  "value": "50000",
                  "description": "Số tiền thanh toán (VNĐ)"
                },
                {
                  "key": "description",
                  "value": "thanh toan hoc phi",
                  "description": "Nội dung chuyển tiền"
                },
                {
                  "key": "template",
                  "value": "compact",
                  "description": "Mẫu thẻ ảnh đầy đủ (header VietQR, khung viền, logo ngân hàng & Napas247)"
                }
              ]
            },
            "description": "Tạo mã QR thanh toán dạng thẻ đầy đủ (kích thước chuẩn 600 x 585 px) bao gồm Header VietQR, khung xanh, QR code, logo Napas247 và logo MBBank."
          },
          "response": []
        },
        {
          "name": "1.2 Tạo chỉ mã QR tinh gọn (template: qr_only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/generate?bankBin=970422&accountNo=056789799999&amount=50000&description=thanh toan hoc phi&template=qr_only",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "generate"],
              "query": [
                {
                  "key": "bankBin",
                  "value": "970422"
                },
                {
                  "key": "accountNo",
                  "value": "056789799999"
                },
                {
                  "key": "amount",
                  "value": "50000"
                },
                {
                  "key": "description",
                  "value": "thanh toan hoc phi"
                },
                {
                  "key": "template",
                  "value": "qr_only",
                  "description": "Mẫu tinh gọn: chỉ có mã QR vuông 500x500px kèm icon VietQR ở chính giữa"
                }
              ]
            },
            "description": "Tạo ảnh mã QR vuông tinh gọn (500 x 500 px) chỉ chứa mã QR và logo VietQR ở tâm, không có viền thẻ và header/footer."
          },
          "response": []
        },
        {
          "name": "1.3 Tạo thẻ VietQR in đầy đủ thông tin (template: print)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vietqr-core/generate?bankBin=970415&accountNo=113366668888&accountName=QUY VAC XIN COVID&amount=790000&description=dong qop quy vac xin&template=print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vietqr-core", "generate"],
              "query": [
                {
                  "key": "bankBin",
                  "value": "970415",
                  "description": "VietinBank"
                },
                {
                  "key": "accountNo",
                  "value": "113366668888",
                  "description": "Số tài khoản nhận tiền"
                },
                {
                  "key": "accountName",
                  "value": "QUY VAC XIN COVID",
                  "description": "Tên chủ tài khoản (hiển thị in hoa)"
                },
                {
                  "key": "amount",
                  "value": "790000",
                  "description": "Số tiền (VND)"
                },
                {
                  "key": "description",
                  "value": "dong qop quy vac xin",
                  "description": "Nội dung chuyển khoản"
                },
                {
                  "key": "template",
                  "value": "print",
                  "description": "Mẫu in đầy đủ: thẻ VietQR kèm thông tin chi tiết thanh toán bên dưới"
                }
              ]
            },
            "description": "Tạo ảnh thẻ VietQR mẫu in (print) đầy đủ thông tin: Header VietQR, khung QR, logo Napas và Ngân hàng, cùng 5 dòng thông tin chi tiết: Số tiền VND, Nội dung CK, Tên chủ TK, Số TK in đậm, và Tên đầy đủ của ngân hàng."
          },
          "response": []
        },
